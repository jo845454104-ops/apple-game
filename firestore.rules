rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 닉네임 금지어. profanity.js의 목록과 같은 내용을 유지할 것.
    // 차단된 기기인지 서버에서 직접 확인한다.
    // 예전 버전 페이지를 열어둔 채 쓰더라도 여기서 걸린다.
    function notBlocked(cid) {
      return !exists(/databases/$(database)/documents/blocked/$(cid));
    }

    // 닉네임을 정식으로 예약한 기기만 활동할 수 있다.
    // 화면(닉네임 입력창)을 건너뛰어도 서버에서 걸린다.
    function ownsNickname(nick, cid) {
      let key = /databases/$(database)/documents/nicknames/$(nick);
      return exists(key) && get(key).data.owner == cid;
    }

    // 운영자 긴급 스위치. config/settings 문서로 채팅을 즉시 잠글 수 있다.
    function chatOpen() {
      let key = /databases/$(database)/documents/config/settings;
      return !exists(key) || get(key).data.get('chatLocked', false) == false;
    }

    // 기호나 공백만으로 된 도배는 서버에서 거른다.
    // (같은 글자 반복은 역참조가 필요해 규칙에서 못 잡으므로 클라이언트에서 처리한다)
    function notSpam(text) {
      return !text.matches('^[.,!?~\\-_/\\s]+$');
    }

    function cleanName(name) {
      return !name.lower().matches('.*(시발|씨발|시바|씨바|쉬발|쒸발|시팔|씨팔|십알|병신|븅신|빙신|등신|좆|좇|존나|졸라|존만|지랄|니미|애미|애비|느금|새끼|쌔끼|새기|개새|개년|개놈|썅|쌍놈|쌍년|미친놈|미친년|또라이|돌아이|보지|자지|꼬추|섹스|야동|강간|젖탱|게이|레즈|호모|트젠|장애인|찐따|일베|틀딱|급식충|맘충|한남|김치녀|자살|꺼져|fuck|shit|bitch|asshole|dick|pussy|gay|fag|정식).*');
    }
    // 점수 기록은 등록만 가능하고 이후 수정·삭제가 불가능하다.
    // 브라우저에서 함수를 직접 호출하더라도 아래 조건을 만족하지 못하면 거부된다.
    match /scores/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'score', 'clears', 'durationMs', 'cid', 'fp', 'createdAt']
        )
        && notBlocked(request.resource.data.get('fp', 'none'))
        && request.resource.data.cid is string
        && request.resource.data.cid.size() > 0
        && notBlocked(request.resource.data.cid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && cleanName(request.resource.data.name)
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 170
        && request.resource.data.clears is number
        && request.resource.data.clears >= 0
        // 한 번에 지우는 사과는 최소 2개다
        && request.resource.data.clears * 2 <= request.resource.data.score
        // 실측 정상 기록은 매칭당 2.13~2.45개다. 여유를 두고 3개로 제한한다.
        && request.resource.data.clears * 3 >= request.resource.data.score
        && request.resource.data.durationMs is number
        && request.resource.data.durationMs <= 125000
        // 실측 정상 속도는 초당 0.86~0.99개(사과당 1.0초 이상)다.
        // 여유를 둬 사과당 0.7초로 잡으면 만점은 최소 119초가 필요하다.
        && request.resource.data.durationMs >= request.resource.data.score * 700
        // 클라이언트가 임의의 시각을 써 넣지 못하도록 서버 시각만 허용한다
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /messages/{doc} {
      allow read: if true;
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && cleanName(request.resource.data.name)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200
        && request.resource.data.keys().hasOnly(['name', 'text', 'cid', 'nk', 'fp', 'createdAt'])
        && notBlocked(request.resource.data.get('fp', 'none'))
        && request.resource.data.cid is string
        && request.resource.data.cid.size() > 0
        && notBlocked(request.resource.data.cid)
        && chatOpen()
        && notSpam(request.resource.data.text)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      // 2시간이 지났거나 100개를 넘긴 대화를 오래된 것부터 정리한다.
      // 2분이 지나야 삭제할 수 있어 방금 오간 대화는 누구도 지울 수 없다.
      allow delete: if resource.data.createdAt is timestamp
        && resource.data.createdAt < request.time - duration.value(2, 'm');
    }

    // 닉네임 선점. 문서 ID가 닉네임이라 이미 있으면 생성이 실패해 중복이 막힌다.
    match /nicknames/{nick} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['owner', 'createdAt'])
        && request.resource.data.owner is string
        && request.resource.data.owner.size() <= 64
        && request.resource.data.createdAt == request.time
        && cleanName(nick)
        && nick.size() > 0
        && nick.size() <= 12;
      allow update, delete: if false;
    }

    // 조작이 감지된 기기 목록. 본인 기기를 등록할 수만 있고 지울 수는 없다.
    match /blocked/{clientId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['reason', 'name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // 룰렛 당첨 기록. 등록만 가능하고 수정·삭제는 막는다.
    match /rewards/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'prize', 'score', 'cid', 'fp', 'createdAt']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && cleanName(request.resource.data.name)
        && request.resource.data.prize is string
        && request.resource.data.prize.size() <= 20
        && request.resource.data.score is number
        && request.resource.data.score >= 100
        && request.resource.data.score <= 170
        && request.resource.data.cid is string
        && notBlocked(request.resource.data.cid)
        && notBlocked(request.resource.data.get('fp', 'none'))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // 운영자 설정. 읽기만 공개하고 변경은 관리 도구(CLI)로만 한다.
    match /config/settings {
      allow read: if true;
      allow write: if false;
    }

    // 접속자 수 집계용 단일 문서. 각 클라이언트가 자기 항목만 갱신한다.
    match /meta/presence {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
