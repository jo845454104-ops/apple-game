rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 닉네임 금지어. profanity.js의 목록과 같은 내용을 유지할 것.
    // 차단된 기기인지 서버에서 직접 확인한다.
    // 예전 버전 페이지를 열어둔 채 쓰더라도 여기서 걸린다.
    // 차단은 매일 한국시간 09:00에 자동으로 풀린다.
    // 한국시간 09:00 = UTC 00:00 이므로 request.time.date()(오늘 UTC 자정)와
    // 비교하면 된다. 그 이전에 걸린 차단은 이미 만료된 것으로 본다.
    function notBlocked(cid) {
      let key = /databases/$(database)/documents/blocked/$(cid);
      return !exists(key) || get(key).data.createdAt < request.time.date();
    }

    // 닉네임을 정식으로 예약한 기기만 활동할 수 있다.
    // 화면(닉네임 입력창)을 건너뛰어도 서버에서 걸린다.
    function ownsNickname(nick, cid) {
      let key = /databases/$(database)/documents/nicknames/$(nick);
      return exists(key) && get(key).data.owner == cid;
    }

    // 운영자 긴급 스위치. config/settings 문서로 채팅을 즉시 잠글 수 있다.
    function chatOpen() {
      let key = /databases/$(database)/documents/config/settings;
      return !exists(key) || get(key).data.get('chatLocked', false) == false;
    }

    // 기호나 공백만으로 된 도배는 서버에서 거른다.
    // (같은 글자 반복은 역참조가 필요해 규칙에서 못 잡으므로 클라이언트에서 처리한다)
    function notSpam(text) {
      return !text.matches('^[.,!?~\\-_/\\s]+$');
    }

    // 기기 ID는 클라이언트가 만든다.
    //   Math.random().toString(36).slice(2,10) + Date.now().toString(36)
    // 이라서 소문자·숫자만 16자 안팎이 나온다.
    // 개발자도구로 짧거나 사람이 읽을 수 있는 값(예: 'jo')을 넣어
    // 차단을 피하려는 시도를 여기서 거른다. 실제로 그런 사례가 있었다.
    function realClientId(cid) {
      return cid is string
        && cid.size() >= 12
        && cid.size() <= 32
        && cid.matches('^[0-9a-z]+$');
    }

    function cleanName(name) {
      return !name.lower().matches('.*(시발|씨발|시바|씨바|쉬발|쒸발|시팔|씨팔|십알|병신|븅신|빙신|등신|좆|좇|존나|졸라|존만|지랄|니미|애미|애비|느금|새끼|쌔끼|새기|개새|개년|개놈|썅|쌍놈|쌍년|미친놈|미친년|또라이|돌아이|보지|자지|꼬추|섹스|야동|강간|젖탱|게이|레즈|호모|트젠|장애인|찐따|일베|틀딱|급식충|맘충|한남|김치녀|자살|꺼져|fuck|shit|bitch|asshole|dick|pussy|gay|fag|정식).*');
    }
    // 점수 기록은 등록만 가능하고 이후 수정·삭제가 불가능하다.
    // 브라우저에서 함수를 직접 호출하더라도 아래 조건을 만족하지 못하면 거부된다.
    match /scores/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'score', 'clears', 'durationMs', 'cid', 'fp', 'seed', 'moves', 'createdAt']
        )
        && request.resource.data.get('moves', '').size() <= 20000
        && notBlocked(request.resource.data.get('fp', 'none'))
        && realClientId(request.resource.data.cid)
        && notBlocked(request.resource.data.cid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && cleanName(request.resource.data.name)
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 170
        && request.resource.data.clears is number
        && request.resource.data.clears >= 0
        // 한 번에 지우는 사과는 최소 2개다
        && request.resource.data.clears * 2 <= request.resource.data.score
        // 실측 정상 기록은 매칭당 2.13~2.45개다. 여유를 두고 3개로 제한한다.
        && request.resource.data.clears * 3 >= request.resource.data.score
        && request.resource.data.durationMs is number
        && request.resource.data.durationMs <= 125000
        // 실측 정상 속도는 초당 0.86~0.99개(사과당 1.0초 이상)다.
        // 여유를 둬 사과당 0.7초로 잡으면 만점은 최소 119초가 필요하다.
        && request.resource.data.durationMs >= request.resource.data.score * 700
        // 클라이언트가 임의의 시각을 써 넣지 못하도록 서버 시각만 허용한다
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // 무한모드(베타) 전용 랭킹. 일반 랭킹과 점수 체계(콤보 배율)가 달라 분리한다.
    // 아직 리플레이 검증이 없어 상한을 넉넉히 잡아 명백한 조작만 거른다.
    match /infiniteScores/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'score', 'combo', 'clears', 'durationMs', 'cid', 'fp', 'createdAt']
        )
        && notBlocked(request.resource.data.get('fp', 'none'))
        && realClientId(request.resource.data.cid)
        && notBlocked(request.resource.data.cid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && cleanName(request.resource.data.name)
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 2000000
        && request.resource.data.combo is number
        && request.resource.data.combo >= 0
        && request.resource.data.combo <= 2000
        && request.resource.data.clears is number
        && request.resource.data.clears >= 0
        // 판정 한 번의 이론상 최대치는 9개 전부 황금 + 최대 배율(×10)이라 1만점대다.
        // 넉넉히 잡아 명백한 조작만 거른다.
        && request.resource.data.score <= (request.resource.data.clears + 1) * 15000
        && request.resource.data.durationMs is number
        && request.resource.data.durationMs >= 0
        && request.resource.data.durationMs <= 1800000
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /messages/{doc} {
      allow read: if true;
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && cleanName(request.resource.data.name)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200
        && request.resource.data.keys().hasOnly(['name', 'text', 'cid', 'nk', 'fp', 'createdAt'])
        && notBlocked(request.resource.data.get('fp', 'none'))
        && realClientId(request.resource.data.cid)
        && notBlocked(request.resource.data.cid)
        && chatOpen()
        && notSpam(request.resource.data.text)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      // 2시간이 지났거나 100개를 넘긴 대화를 오래된 것부터 정리한다.
      // 2분이 지나야 삭제할 수 있어 방금 오간 대화는 누구도 지울 수 없다.
      allow delete: if resource.data.createdAt is timestamp
        && resource.data.createdAt < request.time - duration.value(2, 'm');
    }

    // 닉네임 선점. 문서 ID가 닉네임이라 이미 있으면 생성이 실패해 중복이 막힌다.
    match /nicknames/{nick} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['owner', 'createdAt'])
        && realClientId(request.resource.data.owner)
        && request.resource.data.createdAt == request.time
        && cleanName(nick)
        && nick.size() > 0
        && nick.size() <= 12;

      // 입장 코드에 nick 필드를 넣어두면 그 코드를 정상적으로 점유한 사람은
      // (예전 기기/주소에 걸려 있던) 자기 닉네임 소유권을 새 기기로 옮길 수 있다.
      // claimedBy 로 넘긴 코드 문서의 nick이 이 닉네임과 같고, 그 코드의 현재
      // holder가 새 owner와 같아야 하므로 — 코드를 모르는 사람은 통과할 수 없다.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'claimedBy'])
        && realClientId(request.resource.data.owner)
        && request.resource.data.claimedBy is string
        && exists(/databases/$(database)/documents/passes/$(request.resource.data.claimedBy))
        && get(/databases/$(database)/documents/passes/$(request.resource.data.claimedBy)).data.get('nick', '') == nick
        && get(/databases/$(database)/documents/passes/$(request.resource.data.claimedBy)).data.holder == request.resource.data.owner;
      allow delete: if false;
    }

    // 닉네임 변경 기록. 기기당 문서 하나로, 7일에 한 번만 쓸 수 있다.
    // 클라이언트 화면을 우회해도 여기서 막히므로 간격이 실제로 강제된다.
    match /nickChanges/{cid} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['owner', 'lastChangedAt'])
        && request.resource.data.owner == cid
        && realClientId(cid)
        && request.resource.data.lastChangedAt == request.time;
      // 직전 변경으로부터 7일이 지나야 다시 쓸 수 있다
      allow update: if request.resource.data.keys().hasOnly(['owner', 'lastChangedAt'])
        && request.resource.data.owner == cid
        && realClientId(cid)
        && request.resource.data.lastChangedAt == request.time
        && resource.data.lastChangedAt is timestamp
        && resource.data.lastChangedAt < request.time - duration.value(7, 'd');
      allow delete: if false;
    }

    // ── 입장 코드 ────────────────────────────
    // 운영자가 CLI로 발급한 코드를 가진 사람만 들어온다.
    // 코드 하나는 한 기기만 쓴다. 이미 쓰는 사람이 있으면 나중 사람이 거부된다.
    //
    // get 은 열고 list 는 막는 것이 핵심이다.
    // 목록을 열면 아무나 미사용 코드를 쓸어가 이 장치가 통째로 무의미해진다.
    // 코드를 아는 사람만 그 문서 하나를 확인할 수 있다.
    match /passes/{code} {
      allow get: if true;
      allow list: if false;
      // 발급·회수는 운영자 도구(CLI/콘솔)로만 한다.
      // 웹에 열면 학생이 자기 코드를 얼마든지 만들 수 있다.
      allow create, delete: if false;

      // 자리 잡기와 신호 갱신만 허용한다.
      allow update: if request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['holder', 'holderNk', 'lastSeen'])
        && request.resource.data.holder is string
        && request.resource.data.lastSeen == request.time
        && (
          // 자리를 비우는 것은 언제나 된다
          request.resource.data.holder == ''
          // 빈자리이거나, 내 자리를 이어서 쓰거나,
          || resource.data.get('holder', '') == ''
          || resource.data.get('holder', '') == request.resource.data.holder
          // 앞사람이 90초 넘게 신호가 없으면 이어받는다
          || resource.data.get('lastSeen', request.time) < request.time - duration.value(90, 's')
        )
        // 자리 주인도 정상 기기 ID여야 한다 (빈 값은 자리 비우기)
        && (request.resource.data.holder == ''
            || realClientId(request.resource.data.holder));
    }

    // 차단 목록.
    // 웹에서 쓰기를 허용하면 접속자 목록에 공개된 기기 ID로
    // 누구나 남을(심지어 참가자 전원을) 차단할 수 있다.
    // 그래서 조회만 열고, 등록·해제는 운영자 도구(CLI/콘솔)로만 한다.
    match /blocked/{clientId} {
      allow read: if true;
      allow write: if false;
    }

    // 룰렛 회차 구분. 한국시간 18시(UTC 9시)에 하루가 바뀐다.
    function periodKey() {
      return string(
        request.time.year() * 1000 +
        (request.time.hours() >= 9
          ? request.time.dayOfYear()
          : request.time.dayOfYear() - 1)
      );
    }

    // 룰렛 당첨 기록. 등록만 가능하고 수정·삭제는 막는다.
    // 문서 ID를 "닉네임__회차__번호"로 고정해, 번호가 1~3으로 제한되고
    // 같은 ID를 다시 만들 수 없어 하루 3회를 서버가 강제한다.
    match /rewards/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'nk', 'n', 'prize', 'score', 'cid', 'fp', 'createdAt']
        )
        && request.resource.data.n is int
        && request.resource.data.n >= 1
        && request.resource.data.n <= 3
        && request.resource.data.nk is string
        && request.resource.data.nk.size() > 0
        && doc == request.resource.data.nk + '__' + periodKey() + '__' + string(request.resource.data.n)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && cleanName(request.resource.data.name)
        && request.resource.data.prize is string
        && request.resource.data.prize.size() <= 20
        && request.resource.data.score is number
        && request.resource.data.score >= 100
        && request.resource.data.score <= 170
        && realClientId(request.resource.data.cid)
        && notBlocked(request.resource.data.cid)
        && notBlocked(request.resource.data.get('fp', 'none'))
        // 그 닉네임을 선점한 기기만 그 닉네임으로 룰렛을 돌릴 수 있다.
        // 없으면 남의 닉네임으로 하루 3회를 대신 소진시킬 수 있다.
        && ownsNickname(request.resource.data.nk, request.resource.data.cid)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // 돌발 이벤트 달성 기록.
    // 문서 ID를 "닉네임__이벤트"로 고정해 이벤트당 한 번만 받을 수 있다.
    // 정확한 목표 점수는 클라이언트가 날짜로 계산하지만, 서버는
    // "평일 한국시간 14~17시, 최소 목표(107점) 이상"만은 직접 검증한다.
    match /events/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'nk', 'ev', 'prize', 'score', 'cid', 'fp', 'createdAt']
        )
        && request.resource.data.nk is string
        && request.resource.data.nk.size() > 0
        && request.resource.data.ev is string
        && doc == request.resource.data.nk + '__' + request.resource.data.ev
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && cleanName(request.resource.data.name)
        && request.resource.data.prize is string
        && request.resource.data.prize.size() <= 20
        && request.resource.data.score is number
        && request.resource.data.score >= 107
        && request.resource.data.score <= 170
        // 한국시간 14:00~17:00 = UTC 05:00~08:00
        && request.time.hours() >= 5
        && request.time.hours() < 8
        // 평일만 (1=월 ~ 5=금)
        && request.time.dayOfWeek() >= 1
        && request.time.dayOfWeek() <= 5
        && realClientId(request.resource.data.cid)
        && notBlocked(request.resource.data.cid)
        && notBlocked(request.resource.data.get('fp', 'none'))
        && ownsNickname(request.resource.data.nk, request.resource.data.cid)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ── 상점에서 발급한 티켓 ─────────────────
    // 문서 ID가 일련번호다. 발급 주기 제한은 ID에 회차를 넣어 강제한다.
    //   커피권  : 닉네임__COFFEE__(발급회차)      1인 1장
    //   데이트권: 닉네임__DATE__(3일 단위 회차)   3일에 1장
    //   식사권  : 닉네임__MEAL__(주 단위 회차)    7일에 1장
    match /tickets/{serial} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(
          ['kind', 'owner', 'ownerNk', 'ownerCid', 'issuedTo', 'period', 'state', 'createdAt']
        )
        && request.resource.data.kind in ['COFFEE', 'DATE', 'MEAL']
        && request.resource.data.owner is string
        && request.resource.data.owner.size() > 0
        && request.resource.data.owner.size() <= 12
        && cleanName(request.resource.data.owner)
        && request.resource.data.ownerNk is string
        && realClientId(request.resource.data.ownerCid)
        && notBlocked(request.resource.data.ownerCid)
        && ownsNickname(request.resource.data.ownerNk, request.resource.data.ownerCid)
        && request.resource.data.period is string
        && request.resource.data.state == 'active'
        // 일련번호는 "닉네임__종류__회차" 형태로 고정한다.
        // 같은 회차에 같은 종류를 또 만들 수 없어 발급 주기가 강제된다.
        && serial == request.resource.data.ownerNk + '__'
            + request.resource.data.kind + '__' + request.resource.data.period
        && request.resource.data.createdAt == request.time;

      // 사용 처리와 대결 승리에 따른 이전.
      // 종류·발급자·회차는 절대 바뀌지 않는다.
      allow update: if request.resource.data.kind == resource.data.kind
        && request.resource.data.issuedTo == resource.data.issuedTo
        && request.resource.data.period == resource.data.period
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
          'kind', 'owner', 'ownerNk', 'ownerCid', 'issuedTo', 'period',
          'state', 'createdAt', 'usedAt', 'wonFrom'
        ])
        && request.resource.data.state in ['active', 'used']
        && notBlocked(request.resource.data.ownerCid);

      allow delete: if false;
    }

    // ── 멀티플레이 대결 ──────────────────────
    // 방은 만든 사람이 시드를 정하고, 참가자는 자기 칸에만 결과를 쓴다.
    // 점수는 리플레이 수순과 함께 남겨 나중에 진위를 확인할 수 있다.
    match /duels/{room} {
      allow read: if true;

      // 방 만들기
      allow create: if request.resource.data.keys().hasOnly(
          ['host', 'hostNk', 'hostCid', 'seed', 'stake', 'hostStakes', 'pw', 'state', 'createdAt']
        )
        && request.resource.data.host is string
        && request.resource.data.host.size() > 0
        && request.resource.data.host.size() <= 12
        && cleanName(request.resource.data.host)
        && request.resource.data.hostCid is string
        && notBlocked(request.resource.data.hostCid)
        && ownsNickname(request.resource.data.hostNk, request.resource.data.hostCid)
        && request.resource.data.seed is int
        && request.resource.data.stake is string
        && request.resource.data.stake.size() <= 20
        && request.resource.data.state == 'waiting'
        && request.resource.data.createdAt == request.time;

      // 참가와 결과 제출. 방을 만든 사람 정보와 시드는 바꿀 수 없다.
      allow update: if request.resource.data.host == resource.data.host
        && request.resource.data.hostCid == resource.data.hostCid
        && request.resource.data.seed == resource.data.seed
        && request.resource.data.stake == resource.data.stake
        && request.resource.data.get('hostStakes', []) == resource.data.get('hostStakes', [])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('pw', '') == resource.data.get('pw', '')
        && request.resource.data.keys().hasOnly([
          'host', 'hostNk', 'hostCid', 'seed', 'stake', 'hostStakes', 'pw', 'state', 'createdAt',
          'guest', 'guestNk', 'guestCid', 'guestStakes', 'guestReady', 'startedAt', 'forfeit',
          'hostScore', 'hostMoves', 'guestScore', 'guestMoves', 'settled'
        ])
        && (!('guestCid' in request.resource.data.keys())
            || notBlocked(request.resource.data.guestCid))
        && (!('hostMoves' in request.resource.data.keys())
            || request.resource.data.hostMoves.size() <= 20000)
        && (!('guestMoves' in request.resource.data.keys())
            || request.resource.data.guestMoves.size() <= 20000);

      allow delete: if false;
    }

    // 운영자 설정. 읽기만 공개하고 변경은 관리 도구(CLI)로만 한다.
    match /config/settings {
      allow read: if true;
      allow write: if false;
    }

    // 접속자 수 집계용 단일 문서.
    // 개별 항목까지는 규칙으로 검증할 수 없지만, 문서를 통째로 지우거나
    // 엉뚱한 필드를 심는 것은 막는다.
    match /meta/presence {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['clients'])
        && request.resource.data.clients is map;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
